#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    # enablement made with systemctl when systemd was not running
    rm -f /etc/systemd/system/multi-user.target.wants/varco.service
fi

if [ "$1" = "purge" ]; then
    rm -rf /var/lib/varco
    # optional hardening written by "varco-helper enable ptrace"
    if [ -f /etc/sysctl.d/60-varco-ptrace.conf ]; then
        rm -f /etc/sysctl.d/60-varco-ptrace.conf
        sysctl -q --system >/dev/null 2>&1 || true
    fi
fi

exit 0
