#!/bin/sh
set -e

# Put back every original identifier (MAC address, name, machine-id, serial
# numbers) before the tool disappears. If that fails the removal stops, so the
# original values (kept in /var/lib/varco-privacy) are never lost.
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    if command -v varco-privacy >/dev/null 2>&1; then
        if ! varco-privacy restore --quiet; then
            if [ "${VARCO_PRIVACY_FORCE_REMOVE:-}" = "1" ]; then
                echo "varco-privacy: original identifiers NOT restored; removal forced." >&2
                echo "varco-privacy: the originals stay in /var/lib/varco-privacy/state.json" >&2
            else
                echo "varco-privacy: the original identifiers could not be restored (see above)." >&2
                echo "varco-privacy: removal stopped so they are not lost. Fix the problem and run" >&2
                echo "  varco-privacy restore" >&2
                echo "or force the removal with VARCO_PRIVACY_FORCE_REMOVE=1." >&2
                exit 1
            fi
        fi
    fi
    rm -rf /usr/share/varco/varco_privacy/__pycache__
fi

#DEBHELPER#

exit 0
